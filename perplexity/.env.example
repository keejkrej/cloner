# API Configuration for Perplexity Clone
# Configure directly in the app's Settings dialog, or use as reference.

LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-your-openai-or-openrouter-key
LLM_MODEL=gpt-4o-mini

# Search Provider (tavily, brave, serper, or duckduckgo)
SEARCH_PROVIDER=tavily
TAVILY_API_KEY=tvly-your-tavily-key

# Reranker (local, cohere, or jina)
RERANK_PROVIDER=local
COHERE_API_KEY=your-cohere-key
